<section class="entry-gate" aria-label="Entry door">
  <div class="entry-scene">
    <div class="speech-bubble" aria-live="polite"><span>Who is it?</span></div>
    <div class="door-frame">
      <button class="door-button" type="button" aria-label="Knock on the door"></button>
    </div>
    <p class="entry-message" aria-live="polite"></p>
    <form class="entry-form">
      <label class="sr-only" for="visitor-answer">Your answer</label>
      <input id="visitor-answer" name="answer" autocomplete="off" placeholder="Anyone at all" />
      <button type="submit">Submit</button>
    </form>
  </div>
</section>

<script>
  const gate = document.querySelector(".entry-gate");
  const door = document.querySelector(".door-button");
  const form = document.querySelector(".entry-form");
  const message = document.querySelector(".entry-message");
  const input = document.querySelector("#visitor-answer");
  const storageKey = "kevinreape:door-entered";

  const hasEntered = () => {
    try {
      return sessionStorage.getItem(storageKey) === "true";
    } catch {
      return false;
    }
  };

  const markEntered = () => {
    try {
      sessionStorage.setItem(storageKey, "true");
    } catch {
      // Private or restricted browsing can block storage; the site should still open.
    }
  };

  const closeGate = () => {
    gate?.classList.add("is-exiting");
    document.documentElement.classList.remove("gate-active");
    document.body.classList.remove("gate-locked");
    window.setTimeout(() => gate?.remove(), 560);
  };

  if (gate && !hasEntered()) {
    document.documentElement.classList.add("gate-active");
    document.body.classList.add("gate-locked");
  } else {
    gate?.remove();
  }

  door?.addEventListener("click", () => {
    if (!gate || gate.classList.contains("is-ready")) return;
    gate.classList.add("is-answering");
    if (message) message.textContent = "knock knock";

    window.setTimeout(() => {
      gate.classList.add("is-ready");
      if (input instanceof HTMLInputElement) input.focus();
    }, 720);
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!gate) return;
    if (message) message.textContent = "one moment";

    window.setTimeout(() => {
      gate.classList.add("is-opening");
      markEntered();
      window.setTimeout(closeGate, 920);
    }, 1000);
  });
</script>
