---
import type { MediaItem } from "@/data/media";

type Props = { item: MediaItem };
const { item } = Astro.props;
---

{
  item.link ? (
    <a class="media-card" href={item.link} target="_blank" rel="noreferrer">
      <h3>{item.title}{item.season && <span>{item.season}</span>}</h3>
    </a>
  ) : (
    <article class="media-card">
      <h3>{item.title}{item.season && <span>{item.season}</span>}</h3>
    </article>
  )
}
