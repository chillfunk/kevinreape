---
import type { PhotoItem } from "@/data/photos";

type Props = { photo: PhotoItem };
const { photo } = Astro.props;
---

<button
  class="photo-card"
  type="button"
  data-photo-src={photo.src}
  data-photo-title={photo.title}
  data-photo-date={photo.date}
  data-photo-description={photo.description ?? ""}
  aria-label={`Open ${photo.title}`}
>
  <img src={photo.src} alt={photo.title} loading="lazy" />
  <div class="photo-card-title">
    <h3>{photo.title}</h3>
  </div>
</button>
