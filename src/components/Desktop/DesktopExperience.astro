---
import type { CollectionEntry } from "astro:content";
import DesktopIcon from "./DesktopIcon.astro";
import WindowTemplate from "./WindowTemplate.astro";
import Taskbar from "./Taskbar.astro";
import MobileAppShell from "@/components/Mobile/MobileAppShell.astro";
import PhotosApp from "@/components/Apps/PhotosApp.astro";
import BlogApp from "@/components/Apps/BlogApp.astro";
import SystemInfoApp from "@/components/Apps/SystemInfoApp.astro";
import TimelineApp from "@/components/Apps/TimelineApp.astro";
import WarhammerApp from "@/components/Apps/WarhammerApp.astro";
import ProjectsApp from "@/components/Apps/ProjectsApp.astro";
import NotesApp from "@/components/Apps/NotesApp.astro";
import LinksApp from "@/components/Apps/LinksApp.astro";
import ContactApp from "@/components/Apps/ContactApp.astro";
import type { PhotoItem } from "@/data/photos";
import type { TimelineItem } from "@/data/timeline";
import type { ProjectItem } from "@/data/projects";
import type { NoteItem } from "@/data/notes";
import type { LinkGroup } from "@/data/links";

type RenderedPost = CollectionEntry<"blog"> & {
  rendered: any;
};

type Props = {
  posts: RenderedPost[];
  photos: PhotoItem[];
  timelineItems: TimelineItem[];
  projects: ProjectItem[];
  notes: NoteItem[];
  linkGroups: LinkGroup[];
};

const { posts, photos, timelineItems, projects, notes, linkGroups } = Astro.props;

const apps = [
  { id: "photos", title: "Photos", icon: "photos", width: 780, height: 520 },
  { id: "blog", title: "Blog", icon: "blog", width: 820, height: 540 },
  { id: "system", title: "System Information", icon: "system", width: 680, height: 500 },
  { id: "timeline", title: "Timeline", icon: "timeline", width: 720, height: 520 },
  { id: "warhammer", title: "Warhammer", icon: "warhammer", width: 840, height: 560 },
  { id: "projects", title: "Projects", icon: "projects", width: 780, height: 520 },
  { id: "notes", title: "Notes", icon: "notes", width: 480, height: 500 },
  { id: "links", title: "Links", icon: "links", width: 620, height: 500 },
  { id: "contact", title: "Contact", icon: "contact", width: 520, height: 420 }
];
---

<main class="desktop-os" data-desktop-os>
  <div class="desktop-wallpaper" aria-hidden="true"></div>
  <section class="desktop-layer" aria-label="KevinOS desktop">
    <div class="desktop-intro">
      <p>KevinOS</p>
      <h1>Personal files, open windows, useful scraps.</h1>
    </div>
    <div class="desktop-icons" aria-label="Desktop apps">
      {apps.map((app) => <DesktopIcon app={app.id} label={app.title} icon={app.icon} />)}
    </div>
    <div class="window-layer" data-window-layer></div>
  </section>
  <Taskbar />

  <div class="window-templates" aria-hidden="true">
    <WindowTemplate app="photos" title="Photos"><PhotosApp photos={photos} /></WindowTemplate>
    <WindowTemplate app="blog" title="Blog"><BlogApp posts={posts} /></WindowTemplate>
    <WindowTemplate app="system" title="System Information"><SystemInfoApp /></WindowTemplate>
    <WindowTemplate app="timeline" title="Timeline"><TimelineApp items={timelineItems} /></WindowTemplate>
    <WindowTemplate app="warhammer" title="Warhammer"><WarhammerApp /></WindowTemplate>
    <WindowTemplate app="projects" title="Projects"><ProjectsApp projects={projects} /></WindowTemplate>
    <WindowTemplate app="notes" title="Notes"><NotesApp notes={notes} /></WindowTemplate>
    <WindowTemplate app="links" title="Links"><LinksApp groups={linkGroups} /></WindowTemplate>
    <WindowTemplate app="contact" title="Contact"><ContactApp /></WindowTemplate>
    {
      posts.map((post) => {
        const Content = post.rendered;
        return (
          <WindowTemplate app={`post-${post.slug}`} title={post.data.title}>
            <article class="reader">
              <p class="app-eyebrow">{post.data.date.toLocaleDateString("en-US")}</p>
              <h2>{post.data.title}</h2>
              <p class="reader-description">{post.data.description}</p>
              <ul class="mini-tags">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
              <Content />
            </article>
          </WindowTemplate>
        );
      })
    }
  </div>

  <MobileAppShell apps={apps}>
    <div class="mobile-panels">
      {
        apps.map((app) => (
          <section class="mobile-panel" data-mobile-panel={app.id} aria-label={app.title}>
            <header>
              <button type="button" data-mobile-close>Back</button>
              <h2>{app.title}</h2>
            </header>
            <div class="mobile-panel-body">
              {app.id === "photos" && <PhotosApp photos={photos} />}
              {app.id === "blog" && <BlogApp posts={posts} />}
              {app.id === "system" && <SystemInfoApp />}
              {app.id === "timeline" && <TimelineApp items={timelineItems} />}
              {app.id === "warhammer" && <WarhammerApp />}
              {app.id === "projects" && <ProjectsApp projects={projects} />}
              {app.id === "notes" && <NotesApp notes={notes} />}
              {app.id === "links" && <LinksApp groups={linkGroups} />}
              {app.id === "contact" && <ContactApp />}
            </div>
          </section>
        ))
      }
    </div>
  </MobileAppShell>
</main>

<script is:inline define:vars={{ apps }}>
  const appConfig = new Map(apps.map((app) => [app.id, app]));
  const desktop = document.querySelector("[data-desktop-os]");
  const windowLayer = document.querySelector("[data-window-layer]");
  const taskbarApps = document.querySelector("[data-taskbar-apps]");
  const startButton = document.querySelector("[data-start-button]");
  const startMenu = document.querySelector("[data-start-menu]");
  const clocks = document.querySelectorAll("[data-clock]");
  const iconStorageKey = "kevinos:desktop-icons";
  let topZ = 20;
  let windowOffset = 0;

  const setClock = () => {
    const now = new Date();
    const time = now.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    clocks.forEach((clock) => {
      clock.textContent = time;
      clock.setAttribute("datetime", now.toISOString());
    });
  };

  setClock();
  window.setInterval(setClock, 30000);

  const focusWindow = (win) => {
    topZ += 1;
    win.style.zIndex = String(topZ);
    document.querySelectorAll(".window").forEach((item) => item.classList.toggle("is-active", item === win));
  };

  const syncTaskbar = () => {
    if (!taskbarApps) return;
    taskbarApps.innerHTML = "";
    document.querySelectorAll(".window").forEach((win) => {
      const app = win.dataset.window;
      const title = win.getAttribute("aria-label") || app || "Window";
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = title;
      button.className = win.classList.contains("is-minimized") ? "is-minimized" : "";
      button.addEventListener("click", () => {
        win.classList.toggle("is-minimized");
        focusWindow(win);
        syncTaskbar();
      });
      taskbarApps.append(button);
    });
  };

  const getSavedIconPositions = () => {
    try {
      return JSON.parse(localStorage.getItem(iconStorageKey) || "{}");
    } catch {
      return {};
    }
  };

  const saveIconPosition = (appId, left, top) => {
    try {
      const positions = getSavedIconPositions();
      positions[appId] = { left, top };
      localStorage.setItem(iconStorageKey, JSON.stringify(positions));
    } catch {
      // Storage can be unavailable in private browsing; dragging should still work.
    }
  };

  const resetDesktopLayout = () => {
    try {
      localStorage.removeItem(iconStorageKey);
    } catch {}
    document.querySelectorAll("[data-desktop-icon]").forEach((icon) => {
      icon.style.left = "";
      icon.style.top = "";
      icon.style.position = "";
      icon.dataset.dragged = "";
    });
  };

  const makeDraggable = (win) => {
    const handle = win.querySelector("[data-drag-handle]");
    if (!handle) return;
    handle.addEventListener("pointerdown", (event) => {
      if (event.target instanceof HTMLButtonElement) return;
      focusWindow(win);
      const startX = event.clientX;
      const startY = event.clientY;
      const rect = win.getBoundingClientRect();
      handle.setPointerCapture(event.pointerId);

      const move = (moveEvent) => {
        const nextLeft = Math.min(Math.max(8, rect.left + moveEvent.clientX - startX), window.innerWidth - 120);
        const nextTop = Math.min(Math.max(8, rect.top + moveEvent.clientY - startY), window.innerHeight - 120);
        win.style.left = `${nextLeft}px`;
        win.style.top = `${nextTop}px`;
      };

      const stop = () => {
        handle.removeEventListener("pointermove", move);
        handle.removeEventListener("pointerup", stop);
        handle.removeEventListener("pointercancel", stop);
      };

      handle.addEventListener("pointermove", move);
      handle.addEventListener("pointerup", stop);
      handle.addEventListener("pointercancel", stop);
    });
  };

  const makeResizable = (win) => {
    const handle = win.querySelector("[data-resize-handle]");
    if (!handle) return;
    handle.addEventListener("pointerdown", (event) => {
      focusWindow(win);
      const startX = event.clientX;
      const startY = event.clientY;
      const rect = win.getBoundingClientRect();
      handle.setPointerCapture(event.pointerId);

      const move = (moveEvent) => {
        win.style.width = `${Math.max(320, rect.width + moveEvent.clientX - startX)}px`;
        win.style.height = `${Math.max(260, rect.height + moveEvent.clientY - startY)}px`;
      };

      const stop = () => {
        handle.removeEventListener("pointermove", move);
        handle.removeEventListener("pointerup", stop);
        handle.removeEventListener("pointercancel", stop);
      };

      handle.addEventListener("pointermove", move);
      handle.addEventListener("pointerup", stop);
      handle.addEventListener("pointercancel", stop);
    });
  };

  const attachWindowControls = (win) => {
    win.addEventListener("pointerdown", () => focusWindow(win));
    win.querySelector("[data-close-window]")?.addEventListener("click", () => {
      win.remove();
      syncTaskbar();
    });
    win.querySelector("[data-minimize-window]")?.addEventListener("click", () => {
      win.classList.add("is-minimized");
      syncTaskbar();
    });
    win.querySelectorAll("[data-post-open]").forEach((button) => {
      button.addEventListener("click", () => openWindow(`post-${button.dataset.postOpen}`));
    });
    const openPreview = (button) => {
      const source = button.closest("[data-preview-title]") || button;
      const title = source.getAttribute("data-preview-title") || "Image";
      const description = source.getAttribute("data-preview-description") || "";
      const src = source.getAttribute("data-preview-src") || "";
      const modal = document.createElement("div");
      modal.className = "lightbox";
      modal.innerHTML = `<button type="button" aria-label="Close preview">x</button><div>${src ? `<img src="${src}" alt="">` : ""}<strong>${title}</strong><p>${description}</p></div>`;
      modal.querySelector("button")?.addEventListener("click", () => modal.remove());
      win.append(modal);
    };
    win.querySelectorAll("[data-photo-preview]").forEach((button) => {
      button.addEventListener("dblclick", () => openPreview(button));
      button.addEventListener("click", () => {
        if (button.hasAttribute("data-model-preview")) openPreview(button);
      });
    });
    makeDraggable(win);
    makeResizable(win);
  };

  const openWindow = (appId) => {
    if (!windowLayer) return;
    const existing = windowLayer.querySelector(`[data-window="${appId}"]`);
    if (existing) {
      existing.classList.remove("is-minimized");
      focusWindow(existing);
      syncTaskbar();
      return;
    }

    const template = document.querySelector(`[data-window-template="${appId}"]`);
    if (!(template instanceof HTMLTemplateElement)) return;
    const win = template.content.firstElementChild.cloneNode(true);
    const config = appConfig.get(appId) || { width: 680, height: 480 };
    windowOffset = (windowOffset + 26) % 156;
    win.style.width = `${Math.min(config.width || 680, window.innerWidth - 32)}px`;
    win.style.height = `${Math.min(config.height || 480, window.innerHeight - 96)}px`;
    win.style.left = `${Math.max(16, 140 + windowOffset)}px`;
    win.style.top = `${Math.max(16, 72 + windowOffset)}px`;
    windowLayer.append(win);
    attachWindowControls(win);
    focusWindow(win);
    syncTaskbar();
  };

  const applyIconPositions = () => {
    const positions = getSavedIconPositions();
    document.querySelectorAll("[data-desktop-icon]").forEach((icon) => {
      const appId = icon.dataset.openApp;
      if (!appId || !positions[appId]) return;
      icon.style.position = "absolute";
      icon.style.left = `${positions[appId].left}px`;
      icon.style.top = `${positions[appId].top}px`;
    });
  };

  const makeIconDraggable = (icon) => {
    icon.addEventListener("pointerdown", (event) => {
      if (window.matchMedia("(max-width: 767px)").matches) return;
      const startX = event.clientX;
      const startY = event.clientY;
      const rect = icon.getBoundingClientRect();
      let moved = false;
      icon.setPointerCapture(event.pointerId);

      const move = (moveEvent) => {
        const dx = moveEvent.clientX - startX;
        const dy = moveEvent.clientY - startY;
        if (Math.abs(dx) + Math.abs(dy) > 6) moved = true;
        if (!moved) return;
        const nextLeft = Math.min(Math.max(8, rect.left + dx), window.innerWidth - 104);
        const nextTop = Math.min(Math.max(8, rect.top + dy), window.innerHeight - 150);
        icon.style.position = "absolute";
        icon.style.left = `${nextLeft}px`;
        icon.style.top = `${nextTop}px`;
        icon.dataset.dragged = "true";
      };

      const stop = () => {
        icon.removeEventListener("pointermove", move);
        icon.removeEventListener("pointerup", stop);
        icon.removeEventListener("pointercancel", stop);
        if (moved && icon.dataset.openApp) {
          const current = icon.getBoundingClientRect();
          saveIconPosition(icon.dataset.openApp, current.left, current.top);
          window.setTimeout(() => {
            icon.dataset.dragged = "";
          }, 80);
        }
      };

      icon.addEventListener("pointermove", move);
      icon.addEventListener("pointerup", stop);
      icon.addEventListener("pointercancel", stop);
    });
  };

  applyIconPositions();

  document.querySelectorAll("[data-desktop-icon]").forEach((button) => {
    makeIconDraggable(button);
    button.addEventListener("click", (event) => {
      if (button.dataset.dragged === "true") {
        event.preventDefault();
        event.stopPropagation();
      }
    });
    button.addEventListener("dblclick", () => {
      if (button.dataset.dragged === "true") return;
      openWindow(button.dataset.openApp);
    });
    button.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openWindow(button.dataset.openApp);
      }
    });
  });

  document.querySelectorAll("[data-start-menu] [data-open-app]").forEach((button) => {
    button.addEventListener("click", () => {
      openWindow(button.dataset.openApp);
      if (startMenu instanceof HTMLElement) startMenu.hidden = true;
      startButton?.setAttribute("aria-expanded", "false");
    });
  });

  startButton?.addEventListener("click", () => {
    if (!(startMenu instanceof HTMLElement)) return;
    startMenu.hidden = !startMenu.hidden;
    startButton.setAttribute("aria-expanded", String(!startMenu.hidden));
  });

  document.querySelector("[data-reset-desktop]")?.addEventListener("click", () => {
    resetDesktopLayout();
    if (startMenu instanceof HTMLElement) startMenu.hidden = true;
    startButton?.setAttribute("aria-expanded", "false");
  });

  document.querySelectorAll("[data-mobile-open]").forEach((button) => {
    button.addEventListener("click", () => {
      const panel = document.querySelector(`[data-mobile-panel="${button.dataset.mobileOpen}"]`);
      panel?.classList.add("is-open");
      desktop?.classList.add("mobile-panel-open");
    });
  });

  document.querySelectorAll("[data-mobile-close]").forEach((button) => {
    button.addEventListener("click", () => {
      button.closest(".mobile-panel")?.classList.remove("is-open");
      desktop?.classList.remove("mobile-panel-open");
    });
  });

  document.querySelectorAll(".mobile-panel [data-post-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (button.dataset.postOpen) window.location.href = `/blog/${button.dataset.postOpen}/`;
    });
  });

  document.querySelectorAll(".mobile-panel [data-photo-preview]").forEach((button) => {
    button.addEventListener("click", () => {
      const source = button.closest("[data-preview-title]") || button;
      const title = source.getAttribute("data-preview-title") || "Image";
      const description = source.getAttribute("data-preview-description") || "";
      const src = source.getAttribute("data-preview-src") || "";
      const modal = document.createElement("div");
      modal.className = "mobile-lightbox";
      modal.innerHTML = `<button type="button" aria-label="Close preview">Back</button><div>${src ? `<img src="${src}" alt="">` : ""}<strong>${title}</strong><p>${description}</p></div>`;
      modal.querySelector("button")?.addEventListener("click", () => modal.remove());
      document.body.append(modal);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      document.querySelector(".mobile-panel.is-open")?.classList.remove("is-open");
      desktop?.classList.remove("mobile-panel-open");
      const active = document.querySelector(".window.is-active");
      active?.classList.add("is-minimized");
      syncTaskbar();
    }
  });
</script>
