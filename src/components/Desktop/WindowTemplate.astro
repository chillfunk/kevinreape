---
export type Props = {
  app: string;
  title: string;
};

const { app, title } = Astro.props;
---

<template data-window-template={app} data-window-title={title}>
  <div class="window" data-window={app} role="dialog" aria-label={title}>
    <div class="window-titlebar" data-drag-handle>
      <div class="window-title">
        <span></span>
        <strong>{title}</strong>
      </div>
      <div class="window-actions">
        <button type="button" data-minimize-window aria-label={`Minimize ${title}`}>_</button>
        <button type="button" data-close-window aria-label={`Close ${title}`}>x</button>
      </div>
    </div>
    <div class="window-content">
      <slot />
    </div>
    <span class="resize-handle" data-resize-handle aria-hidden="true"></span>
  </div>
</template>
