<footer class="taskbar" aria-label="Desktop taskbar">
  <button class="start-button" type="button" data-start-button aria-expanded="false" aria-controls="start-menu">
    <span>KR</span>
    Start
  </button>
  <div class="start-menu" id="start-menu" data-start-menu hidden>
    <button type="button" data-open-app="system">System Information</button>
    <button type="button" data-reset-desktop>Reset desktop layout</button>
  </div>
  <div class="taskbar-apps" data-taskbar-apps aria-label="Open windows"></div>
  <time class="taskbar-clock" data-clock>--:--</time>
</footer>
