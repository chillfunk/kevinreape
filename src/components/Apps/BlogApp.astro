---
import type { CollectionEntry } from "astro:content";

type Props = {
  posts: CollectionEntry<"blog">[];
};

const { posts } = Astro.props;
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric"
  });
---

<div class="file-list">
  {
    posts.map((post) => (
      <article class="file-row">
        <button class="file-open" type="button" data-post-open={post.slug}>
          <span class="file-icon">MD</span>
          <span>
            <strong>{post.data.title}</strong>
            <small>{formatDate(post.data.date)} / {post.data.description}</small>
          </span>
        </button>
        <ul class="mini-tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </article>
    ))
  }
</div>
