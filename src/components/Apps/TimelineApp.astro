---
import type { TimelineItem } from "@/data/timeline";

type Props = {
  items: TimelineItem[];
};

const { items } = Astro.props;
---

<div class="os-timeline">
  {
    items.map((item) => (
      <article>
        <time>{item.date}</time>
        <div>
          <span>{item.category}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          {item.link && <a href={item.link.href}>{item.link.label}</a>}
        </div>
      </article>
    ))
  }
</div>
