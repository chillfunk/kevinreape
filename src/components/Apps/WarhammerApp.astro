---
import { warhammer } from "@/data/warhammer";
---

<div class="fake-browser">
  <div class="browser-bar">
    <span></span>
    <div>https://kevinreape.local/crusade/{warhammer.faction.toLowerCase().replaceAll(" ", "-")}</div>
  </div>
  <div class="warhammer-page">
    <p class="app-eyebrow">Crusade Registry</p>
    <h2>{warhammer.faction}</h2>
    <p>{warhammer.overview}</p>

    <div class="war-grid">
      <section>
        <h3>Units Owned</h3>
        <div class="unit-list">
          {warhammer.ownedUnits.map((unit) => (
            <article>
              <strong>{unit.name}</strong>
              <span>{unit.category} / {unit.points} pts</span>
              <div class="war-status-row">
                <mark>{unit.assemblyStatus}</mark>
                <mark>{unit.paintingStatus}</mark>
              </div>
              {unit.notes && <p>{unit.notes}</p>}
              {unit.images && (
                <div class="model-thumbs">
                  {unit.images.map((image) => (
                    <button
                      type="button"
                      data-photo-preview
                      data-model-preview
                      data-preview-title={unit.name}
                      data-preview-description={image.alt}
                      data-preview-src={image.src}
                    >
                      <img src={image.src} alt="" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
      <section>
        <h3>Units Wanted</h3>
        <ul class="wanted-list">
          {warhammer.wantedItems.map((item) => (
            <li>
              <strong>{item.name}</strong>
              <span>{item.priority} priority</span>
              {item.notes && <p>{item.notes}</p>}
              {item.link && <a href={item.link}>Reference</a>}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section>
      <h3>Notes</h3>
      <ul class="note-list">
        {warhammer.notes.map((note) => <li>{note}</li>)}
      </ul>
    </section>
  </div>
</div>
