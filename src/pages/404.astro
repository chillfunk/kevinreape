---
import BaseLayout from "@/components/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The page you were looking for could not be found.">
  <main class="page">
    <section class="container hero">
      <div>
        <p class="eyebrow">404</p>
        <h1>That door does not open.</h1>
        <p class="hero-copy">
          The page may have moved, or the address may have taken a wrong turn.
        </p>
        <p><a href="/">Return to the blog</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
