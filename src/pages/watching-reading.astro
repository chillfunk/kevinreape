---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MediaCard from "@/components/MediaCard.astro";
import { mediaItems } from "@/data/media";

const screenItems = mediaItems.filter((item) => item.category === "screen");
const shelfItems = mediaItems.filter((item) => item.category === "shelf");
const holdItems = mediaItems.filter((item) => item.category === "hold");
---

<BaseLayout title="Watching & Reading" description="Things Kevin is watching, reading, listening to, playing, or thinking about.">
  <main class="page game-content-page">
    <div class="container">
      <header class="page-heading game-panel hero-panel">
        <p class="eyebrow">Watching & Reading</p>
        <h1>Current queue.</h1>
      </header>
      <section class="media-columns">
        <div>
          <div class="page-heading section-heading">
            <h2>On screen.</h2>
          </div>
          <div class="media-list">
            {screenItems.map((item) => <MediaCard item={item} />)}
          </div>
        </div>
        <div>
          <div class="page-heading section-heading">
            <h2>On shelf.</h2>
          </div>
          <div class="media-list">
            {shelfItems.map((item) => <MediaCard item={item} />)}
          </div>
        </div>
        <div>
          <div class="page-heading section-heading">
            <h2>On hold.</h2>
          </div>
          <div class="media-list">
            {holdItems.map((item) => <MediaCard item={item} />)}
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
