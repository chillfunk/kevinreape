---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PhotoCard from "@/components/PhotoCard.astro";
import { existsSync, readdirSync, statSync } from "node:fs";
import { join } from "node:path";
import type { PhotoItem } from "@/data/photos";

const allowedPhotoExtensions = /\.(jpe?g|png|webp|gif)$/i;
const photosDirectory = join(process.cwd(), "public", "images", "photos");
const files = existsSync(photosDirectory)
  ? readdirSync(photosDirectory, { withFileTypes: true }).filter(
      (file) => file.isFile() && allowedPhotoExtensions.test(file.name)
    )
  : [];

const sortedPhotos: PhotoItem[] = files
  .map((file) => {
    const src = `/images/photos/${encodeURIComponent(file.name)}`;
    const stats = statSync(join(photosDirectory, file.name));

    return {
      id: file.name,
      src,
      sortDate: stats.mtime.toISOString()
    };
  })
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate));
---

<BaseLayout title="Photos" description="A chronological photo feed from Kevin Reape.">
  <main class="page game-content-page">
    <div class="container">
      <header class="page-heading game-panel hero-panel">
        <p class="eyebrow">Photos</p>
        <h1>Visual archive.</h1>
      </header>
      {
        sortedPhotos.length > 0 ? (
          <section class="photo-grid">
            {sortedPhotos.map((photo) => <PhotoCard photo={photo} />)}
          </section>
        ) : (
          <section class="empty-state">
            <p>No photos yet. Add JPG, PNG, WEBP, or GIF files to <code>public/images/photos</code>.</p>
          </section>
        )
      }

      <dialog class="photo-dialog" aria-label="Photo viewer">
        <button class="photo-dialog-close" type="button" aria-label="Close photo viewer">Close</button>
        <figure>
          <img data-photo-dialog-image alt="" />
        </figure>
      </dialog>
    </div>
  </main>

  <script>
    const dialog = document.querySelector(".photo-dialog");
    const dialogImage = document.querySelector("[data-photo-dialog-image]");
    const closeButton = document.querySelector(".photo-dialog-close");

    document.querySelectorAll(".photo-card").forEach((card) => {
      card.addEventListener("click", () => {
        if (!(dialog instanceof HTMLDialogElement) || !(dialogImage instanceof HTMLImageElement)) return;

        const src = card.getAttribute("data-photo-src") ?? "";

        dialogImage.src = src;
        dialog.showModal();
      });
    });

    closeButton?.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });
  </script>
</BaseLayout>
