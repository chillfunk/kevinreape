---
import BaseLayout from "@/components/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="About Kevin Reape, including work, creative projects, interests, and contact links."
>
  <main class="page">
    <section class="container hero">
      <div>
        <p class="eyebrow">About</p>
        <h1>A useful placeholder for a real person.</h1>
        <p class="hero-copy">
          This page is ready for the sharper, truer version of the story. For now, it sketches the shape of a personal profile without pretending the placeholders are final.
        </p>
      </div>
    </section>

    <section class="container content-grid">
      <div class="section-stack">
        <section>
          <h2>Who I Am</h2>
          <p>
            Placeholder copy for a concise personal introduction: background, current focus, and the kind of questions that keep pulling me forward.
          </p>
        </section>
        <section>
          <h2>Work</h2>
          <p>
            Placeholder copy for professional experience, strengths, collaborations, and the problems I like helping people untangle.
          </p>
        </section>
        <section>
          <h2>Creative Projects</h2>
          <p>
            Placeholder copy for experiments, writing, tools, media, or other projects that deserve a public shelf.
          </p>
        </section>
        <section>
          <h2>Personal Interests</h2>
          <p>
            Placeholder copy for the things outside work that add texture: reading, making, exploring, collecting, learning, and noticing.
          </p>
        </section>
      </div>
      <aside class="panel" aria-label="Contact and social links">
        <h2>Elsewhere</h2>
        <p>Contact and social links can live here.</p>
        <ul>
          <li><a href="mailto:hello@example.com">Email placeholder</a></li>
          <li><a href="https://www.linkedin.com/">LinkedIn placeholder</a></li>
          <li><a href="https://github.com/">GitHub placeholder</a></li>
        </ul>
      </aside>
    </section>
  </main>
</BaseLayout>
