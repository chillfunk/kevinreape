---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/components/BaseLayout.astro";
import DesktopExperience from "@/components/Desktop/DesktopExperience.astro";
import { photos } from "@/data/photos";
import { timelineItems } from "@/data/timeline";
import { projects } from "@/data/projects";
import { notes } from "@/data/notes";
import { linkGroups } from "@/data/links";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const renderedPosts = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return { ...post, rendered: Content };
  })
);
---

<BaseLayout
  title="Kevin Reape"
  description="Kevin Reape's personal operating system for writing, projects, photos, links, and notes."
>
  <DesktopExperience
    posts={renderedPosts}
    photos={photos}
    timelineItems={timelineItems}
    projects={projects}
    notes={notes}
    linkGroups={linkGroups}
  />
</BaseLayout>
