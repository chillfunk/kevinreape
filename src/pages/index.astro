---
import { getCollection } from "astro:content";
import BaseLayout from "@/components/BaseLayout.astro";
import EntryGate from "@/components/EntryGate.astro";
import PostCard from "@/components/PostCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Kevin Reape"
  description="A personal blog for essays, projects, notes, and strange little thresholds."
>
  <EntryGate />
  <main class="page">
    <section class="container hero">
      <div>
        <p class="eyebrow">Personal blog</p>
        <h1>Notes from the threshold.</h1>
        <p class="hero-copy">
          Essays, project notes, and occasional field reports from the places where work, creativity, and curiosity start talking to each other.
        </p>
      </div>
      <p class="hero-note">
        Newest posts first. The archive is intentionally simple, fast, and easy to grow.
      </p>
    </section>
    <section class="container" aria-label="Latest posts">
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </main>
</BaseLayout>
