---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Kevin Reape"
  description="Kevin Reape's personal site for writing, photos, Warhammer, notes, and media."
  hideChrome
>
  <main class="main-menu-screen">
    <div class="menu-backdrop" aria-hidden="true"></div>
    <header class="game-topbar">
      <a class="game-logo" href="/" aria-label="Home">
        <span>Vibeologist</span>
        <strong>CHILLFUNK</strong>
      </a>
      <div class="game-profile">
        <span>KR</span>
        <strong>Online</strong>
      </div>
    </header>

    <section class="game-menu" aria-label="Main menu">
      <p class="game-kicker">Personal archive</p>
      <nav>
        <a href="/blog/">Blog</a>
        <a href="/photos/">Photos</a>
        <a href="/notes/">Field Notes</a>
        <a href="/warhammer/">Warhammer</a>
        <a href="/watching-reading/">The Queue</a>
      </nav>
    </section>

    <section class="hero-character" aria-label="Chillfunk hero image">
      <div class="wing wing-left"></div>
      <div class="wing wing-right"></div>
      <div class="portrait-standin">
        <img class="hero-portrait" src="/images/chillfunk-hero.webp" alt="Chillfunk hero portrait" />
      </div>
      <div class="character-label">
        <strong>CHILLFUNK</strong>
        <span>34 / 34 MISSIONS UNLOCKED</span>
      </div>
    </section>
  </main>
</BaseLayout>
