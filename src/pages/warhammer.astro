---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { armies, type HobbyStatus } from "@/data/warhammer";

const modelCount = (army: (typeof armies)[number]) => army.units.reduce((sum, unit) => sum + unit.count, 0);
const statusCount = (army: (typeof armies)[number], status: HobbyStatus) =>
  army.units.filter((unit) => (unit.status ?? "Unassembled") === status).reduce((sum, unit) => sum + unit.count, 0);
const totalModels = armies.reduce((sum, army) => sum + modelCount(army), 0);
const totalPainted = armies.reduce((sum, army) => sum + statusCount(army, "Painted"), 0);
const totalBuilt = armies.reduce((sum, army) => sum + statusCount(army, "Built"), 0);
const paintedPercent = Math.round((totalPainted / totalModels) * 100);
const categories = ["Characters", "Infantry", "Vehicles"] as const;
---

<BaseLayout title="Warhammer Collection" description="Three-army Warhammer 40K collection and hobby progress dashboard.">
  <main class="page game-content-page war-dashboard">
    <div class="container">
      <header class="war-command">
        <div>
          <p class="eyebrow">Collection command // 03 active forces</p>
          <h1>The War Room</h1>
        </div>
        <div class="command-seal" aria-hidden="true"><span>40</span><small>K</small></div>
      </header>

      <section class="collection-stats" aria-label="Collection progress">
        <article><span>Collection</span><strong>{totalModels}</strong><small>models tracked</small></article>
        <article><span>Painted</span><strong>{totalPainted}</strong><small>{paintedPercent}% complete</small></article>
        <article><span>On the desk</span><strong>{totalBuilt}</strong><small>Built · awaiting paint</small></article>
        <article class="focus-stat"><span>Current directive</span><strong>Black Templars</strong><small>Clean 1,500 points built</small></article>
      </section>

      <div class="overall-progress" aria-label={`${paintedPercent}% of collection painted`}>
        <div><span>Overall painting progress</span><b>{paintedPercent}%</b></div>
        <div class="progress-track"><i style={`width: ${paintedPercent}%`}></i></div>
      </div>

      <nav class="army-switcher" aria-label="Filter collection by army">
        <button type="button" class="is-active" data-army-filter="all">All forces <span>{totalModels}</span></button>
        {armies.map((army) => <button type="button" data-army-filter={army.id}>{army.name} <span>{modelCount(army)}</span></button>)}
      </nav>

      <section class="army-overview" aria-label="Army overview">
        {armies.map((army, index) => {
          const total = modelCount(army);
          const painted = statusCount(army, "Painted");
          const built = statusCount(army, "Built");
          const percent = Math.round((painted / total) * 100);
          return (
            <article class={`army-card army-${army.id}`} data-army={army.id} style={`--army-accent: ${army.accent}`}>
              <header>
                <span class="army-index">0{index + 1}</span>
                <h2>{army.name}</h2>
                <span class="army-monogram">{army.shortName}</span>
              </header>
              <p class="army-role">{army.role}</p>
              <p class="army-theme">{army.theme}</p>
              <div class="army-meter">
                <div><span>{painted} painted · {built} built</span><b>{percent}%</b></div>
                <div class="progress-track"><i style={`width: ${percent}%`}></i></div>
              </div>
              <dl>
                <div><dt>Models</dt><dd>{total}</dd></div>
                <div><dt>Scheme</dt><dd>{army.scheme}</dd></div>
              </dl>
            </article>
          );
        })}
      </section>

      <section class="dashboard-section manifest-section">
        <header class="dashboard-heading"><div><p class="eyebrow">The manifest</p><h2>Everything on the shelf.</h2></div><div class="status-key" aria-label="Model status key"><span><i class="status-dot status-painted"></i> Painted</span><span><i class="status-dot status-built"></i> Built</span><span><i class="status-dot status-unassembled"></i> Unassembled</span></div></header>
        <div class="army-manifests">
          {armies.map((army) => (
            <article class="army-manifest" data-army={army.id} style={`--army-accent: ${army.accent}`}>
              <header><div><span>{army.shortName}</span><h3>{army.name}</h3></div><b>{modelCount(army)} models</b></header>
              <div class="manifest-columns">
                {categories.map((category) => {
                  const units = army.units.filter((unit) => unit.category === category);
                  const count = units.reduce((sum, unit) => sum + unit.count, 0);
                  return (
                    <section class="manifest-category">
                      <h4>{category}<span>{count}</span></h4>
                      <ul>
                        {units.map((unit) => {
                          const status = unit.status ?? "Unassembled";
                          return (
                            <li>
                              <span class={`status-dot status-${status.toLowerCase().replace(" ", "-")}`} title={status}></span>
                              <div><strong>{unit.name}</strong>{(unit.source || unit.note) && <small>{[unit.source, unit.note].filter(Boolean).join(" · ")}</small>}</div>
                              <b>×{unit.count}</b>
                            </li>
                          );
                        })}
                      </ul>
                    </section>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="dashboard-section planning-grid">
        <article class="wishlist-panel">
          <p class="eyebrow">Reinforcement queue</p><h2>Future acquisitions.</h2>
          <div class="acquisition-columns">{armies.map((army) => <section data-army={army.id}><h3 style={`--army-accent: ${army.accent}`}>{army.name}</h3><ul>{army.wanted.map((item) => <li>{item}</li>)}</ul></section>)}</div>
        </article>
      </section>
    </div>
  </main>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-army-filter]");
    const filterable = document.querySelectorAll<HTMLElement>("[data-army]");
    buttons.forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.armyFilter;
      buttons.forEach((item) => item.classList.toggle("is-active", item === button));
      filterable.forEach((item) => item.hidden = filter !== "all" && item.dataset.army !== filter);
    }));
  </script>
</BaseLayout>
