---
import BaseLayout from "@/components/BaseLayout.astro";
import { timelineItems } from "@/data/timeline";
---

<BaseLayout
  title="Timeline"
  description="Important life, work, writing, and project milestones from Kevin Reape."
>
  <main class="page-fallback">
    <section>
      <h1>Timeline</h1>
      <p>This route is a direct, SEO-friendly fallback for the desktop Timeline app.</p>
      <div class="os-timeline">
        {
          timelineItems.map((item) => (
            <article>
              <time>{item.date}</time>
              <div>
                <span>{item.category}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                {item.link && <a href={item.link.href}>{item.link.label}</a>}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
